# Production template. Placeholders only — generate every secret before use,
# for example with `openssl rand -base64 48`.
#
# Startup validation rejects this file as-is: the "generate-..." placeholders,
# the example.com domain, and loopback datastore hosts all fail fast.
NODE_ENV=production
PORT=3001
HOST=0.0.0.0

# --- Datastores -------------------------------------------------------------
# Hostnames are the compose service names: these are reachable only on the
# internal network and are never published to the host.
POSTGRES_USER=fools_gold_app
POSTGRES_PASSWORD=generate-a-long-random-value
POSTGRES_DB=fools_gold
REDIS_PASSWORD=generate-a-different-long-random-value
# URL-encode any reserved characters in the passwords below. The raw values stay
# in POSTGRES_PASSWORD and REDIS_PASSWORD for the datastore containers.
DATABASE_URL=postgresql://fools_gold_app:generate-a-long-random-value@postgres:5432/fools_gold?schema=public
REDIS_URL=redis://:generate-a-different-long-random-value@redis:6379

# --- Auth -------------------------------------------------------------------
# Must be 32+ characters, mutually distinct, and high entropy.
JWT_ACCESS_SECRET=generate-at-least-32-random-characters
JWT_REFRESH_SECRET=generate-a-different-at-least-32-character-secret
# Enable only long enough to create the first admin, then set back to false.
REGISTRATION_ENABLED=false
# AES-256-GCM key for the revealable-password vault: 32 random bytes, base64 (required in production).
PASSWORD_VAULT_KEY=generate-32-random-bytes-base64
PASSWORD_VAULT_KEY_ID=v1

# --- HTTP / proxy -----------------------------------------------------------
# DOMAIN drives both TLS certificates and the API hostname (api.DOMAIN).
DOMAIN=example.com
ADMIN_EMAIL=security-contact@example.com
FRONTEND_URL=https://example.com
CORS_ORIGINS=https://example.com
COOKIE_SECURE=true
# Keep this on: production refuses to start unless it is exactly "true".
TRUST_PROXY=true
# Required in production: the IPs or CIDR ranges of the reverse proxy that may
# set X-Forwarded-For. There is no blanket trust and no hop count, so a request
# that reaches the backend directly cannot forge its own rate-limit identity.
# Replace with the Caddy container address or its subnet. Never 0.0.0.0/0, ::/0
# or *.
TRUST_PROXY_ALLOWLIST=replace-with-the-proxy-ip-or-cidr
BODY_LIMIT=1mb

# --- Sports provider --------------------------------------------------------
SPORTS_PROVIDER=the-odds-api
THE_ODDS_API_KEY=
THE_ODDS_API_BASE_URL=https://api.the-odds-api.com/v4
SPORTS_SETTLEMENT_ENABLED=false

# --- Casino -----------------------------------------------------------------
CASINO_CRASH_WORKER_ENABLED=true

# Require Google Authenticator for administrators before any admin route works.
ADMIN_MFA_REQUIRED=true
