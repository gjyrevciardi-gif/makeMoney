NODE_ENV=production
POSTGRES_USER=fools_gold_app
POSTGRES_PASSWORD=generate-a-long-random-value
POSTGRES_DB=fools_gold
REDIS_PASSWORD=generate-a-different-long-random-value
DATABASE_URL=postgresql://fools_gold_app:generate-a-long-random-value@postgres:5432/fools_gold?schema=public
REDIS_URL=redis://:generate-a-different-long-random-value@redis:6379
JWT_ACCESS_SECRET=generate-at-least-32-random-characters
JWT_REFRESH_SECRET=generate-a-different-at-least-32-character-secret
DOMAIN=example.com
ADMIN_EMAIL=security-contact@example.com
FRONTEND_URL=https://example.com
CORS_ORIGINS=https://example.com
COOKIE_SECURE=true
TRUST_PROXY=true
REGISTRATION_ENABLED=false
SPORTS_PROVIDER=the-odds-api
THE_ODDS_API_KEY=
THE_ODDS_API_BASE_URL=https://api.the-odds-api.com/v4
SPORTS_SETTLEMENT_ENABLED=false
CASINO_CRASH_WORKER_ENABLED=true
PORT=3001
