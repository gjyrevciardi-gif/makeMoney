# Keep build context small and keep secrets out of images entirely.
node_modules
**/node_modules
.git
.gitignore
.github

# Never ship a real environment file. The example files carry placeholders only
# and are useful inside the image for reference.
.env*
!.env.example
!.env.production.example

# Build output is produced inside the image, never copied from the host.
.next
**/.next
dist
**/dist
*.tsbuildinfo
**/*.tsbuildinfo
coverage
**/coverage

# Operational data and local scratch space.
backups
logs
tmp
*.log
*.dump
*.sql.gz
# Stray dumps at the context root only. Do NOT widen this to **/*.sql: the
# Prisma migration files under backend/prisma/migrations are .sql, and the
# backend image cannot run `migrate deploy` without them.
/*.sql

# Editor and OS noise.
.idea
.vscode
.DS_Store
Thumbs.db

# Credentials and key material must never enter a build context.
*.pem
*.key
*.crt
*.p12
*.pfx
*.jks

# Compose and docs are not needed to build either image.
docker-compose*.yml
Caddyfile
docs
*.md
!README.md
