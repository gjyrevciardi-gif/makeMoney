# Reverse proxy and TLS terminator.
#
# Caddy obtains and renews certificates automatically for whatever real hostname
# DOMAIN resolves to, and redirects HTTP to HTTPS on its own. With a non-public
# DOMAIN (localhost) it falls back to its internal CA, so the same file works for
# a local rehearsal of the stack.
{
	email {$ADMIN_EMAIL}
	servers {
		# The upstreams are the only thing behind this proxy, so client headers
		# are rewritten here rather than trusted.
		trusted_proxies static private_ranges
	}
}

(hardened) {
	encode gzip zstd

	# Bounds the request body before it ever reaches Node; the backend enforces
	# the same ceiling again through BODY_LIMIT.
	request_body {
		max_size 1MB
	}

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		# Do not advertise the proxy or its version.
		-Server
		-X-Powered-By
	}
}

(upstream_headers) {
	# X-Forwarded-For / -Proto / -Host are set by Caddy on every proxied request;
	# the backend runs with `trust proxy = 1` so it reads the real client IP from
	# them for rate limiting. Any inbound value a client tried to set is replaced,
	# not appended to.
	header_up X-Real-IP {remote_host}
	header_up X-Forwarded-Host {host}
}

{$DOMAIN} {
	import hardened

	# Health probes are answered by the backend even on the apex host, so an
	# uptime monitor can watch the public name.
	handle /health/* {
		reverse_proxy backend:3001 {
			import upstream_headers
		}
	}

	handle {
		reverse_proxy frontend:3000 {
			import upstream_headers
		}
	}
}

api.{$DOMAIN} {
	import hardened

	reverse_proxy backend:3001 {
		import upstream_headers
	}
}
