# Reverse proxy and TLS terminator.
#
# Caddy obtains and renews certificates automatically for whatever real hostname
# DOMAIN resolves to, and redirects HTTP to HTTPS on its own.
{
	email {$ADMIN_EMAIL}
	# Empty in production, where publicly trusted certificates are the whole
	# point. A local rehearsal of this stack cannot satisfy an ACME challenge —
	# the hostname is not publicly reachable — so set
	# CADDY_GLOBAL_OPTIONS=local_certs there to sign with Caddy's internal CA
	# instead. Leaving it unset, as production does, changes nothing.
	{$CADDY_GLOBAL_OPTIONS}
	servers {
		# The upstreams are the only thing behind this proxy, so client headers
		# are rewritten here rather than trusted.
		trusted_proxies static private_ranges
	}
}

(hardened) {
	encode gzip zstd

	# Bounds the request body before it ever reaches Node; the backend enforces
	# the same ceiling again through BODY_LIMIT.
	request_body {
		max_size 1MB
	}

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		# Do not advertise the proxy or its version.
		-Server
		-X-Powered-By
	}
}

(upstream_headers) {
	# Caddy already sets X-Forwarded-For / -Proto / -Host on every proxied
	# request, replacing whatever the client sent rather than appending to it.
	# The backend runs with `trust proxy = 1` and reads the real client IP from
	# them for rate limiting. Only X-Real-IP has to be added explicitly.
	header_up X-Real-IP {remote_host}
}

{$DOMAIN} {
	import hardened

	# Health probes are answered by the backend even on the apex host, so an
	# uptime monitor can watch the public name.
	handle /health/* {
		reverse_proxy backend:3001 {
			import upstream_headers
		}
	}

	handle {
		reverse_proxy frontend:3000 {
			import upstream_headers
		}
	}
}

api.{$DOMAIN} {
	import hardened

	reverse_proxy backend:3001 {
		import upstream_headers
	}
}
