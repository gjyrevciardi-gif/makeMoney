NODE_ENV=development
APP_VERSION=dev
BUILD_COMMIT=local
DATABASE_URL=postgresql://fools_gold:change-me@localhost:5432/fools_gold?schema=public
REDIS_URL=redis://localhost:6380
REDIS_PORT=6380
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
REGISTRATION_ENABLED=true
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=false
COOKIE_SECURE=false
DOMAIN=localhost
ADMIN_EMAIL=operator@example.com
LOG_LEVEL=info
BODY_LIMIT=1mb
THE_ODDS_API_KEY=
THE_ODDS_API_BASE_URL=https://api.the-odds-api.com/v4
SPORTS_PROVIDER=the-odds-api
SPORTS_CACHE_TTL_SECONDS=3600
EVENTS_CACHE_TTL_SECONDS=120
ODDS_CACHE_TTL_SECONDS=20
SPORTS_PROVIDER_TIMEOUT_MS=5000
PRIMARY_BOOKMAKER_KEYS=
MAX_VIRTUAL_BET_STAKE=1000000
MAX_ACCUMULATOR_LEGS=10
MAX_ODDS_STALENESS_SECONDS=30
SPORTS_SETTLEMENT_ENABLED=false
SPORTS_SETTLEMENT_POLL_SECONDS=300
SPORTS_STALE_BET_AFTER_MINUTES=180
SPORTS_WORKER_LOCK_TTL_SECONDS=60
SPORTS_LOW_QUOTA_THRESHOLD=100
# Casino uses fixed, versioned virtual-game configuration.
CASINO_MIN_STAKE=1
CASINO_MAX_STAKE=1000000
CASINO_DICE_RTP_BPS=9700
CASINO_MINES_RTP_BPS=9700
CASINO_CRASH_RTP_BPS=9700
# Plinko paytables are frozen versioned constants.
CASINO_CRASH_WORKER_ENABLED=true
CASINO_CRASH_SWEEP_MS=2000
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
PORT=3001
