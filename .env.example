# Local development defaults. Placeholders only — never commit real credentials.
# Copy to .env and adjust. For production use .env.production.example instead.
NODE_ENV=development
APP_VERSION=dev
BUILD_COMMIT=local
PORT=3001
HOST=0.0.0.0

# --- Datastores -------------------------------------------------------------
# Matches docker-compose.yml, which binds these to loopback only.
DATABASE_URL=postgresql://fools_gold:fools_gold@localhost:5432/fools_gold?schema=public
REDIS_URL=redis://localhost:6380
REDIS_PORT=6380
POSTGRES_USER=fools_gold
POSTGRES_PASSWORD=fools_gold
POSTGRES_DB=fools_gold
REDIS_PASSWORD=

# --- Auth -------------------------------------------------------------------
# Production rejects these placeholders: it requires 32+ characters, two
# distinct secrets, and enough entropy that neither looks generated by hand.
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
REGISTRATION_ENABLED=true

# --- HTTP / proxy -----------------------------------------------------------
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
# Loopback origin of the imported Lucky Lady game client. It is a separate
# hostname from the platform on purpose: the recovered third-party bundle never
# shares an origin, cookie or credential with the authenticated application.
NEXT_PUBLIC_LUCKY_LADY_URL=http://127.0.0.1:8790

# --- Lucky Lady gateway (games/lucky-lady/gateway/server.mjs) ---------------
# Serves the recovered client on its own loopback origin and forwards only the
# one game protocol route to the platform.
LUCKY_LADY_GATEWAY_PORT=8790
LUCKY_LADY_ORIGIN=http://127.0.0.1:8790
# Origin of the recovered 185-file client. It stays outside Git.
LUCKY_LADY_CLIENT_DIR=C:/path/to/LuckyLadysCharmDX
# The only origins allowed to exchange a launch capability. The launcher uses
# rel=noopener so the POST preserves its Origin; missing/null origins are denied.
LUCKY_LADY_LAUNCH_ORIGINS=http://localhost:3000
# Set to true only to expose the client beyond loopback; the gateway refuses a
# non-loopback host or a platform host that shares the game's hostname.
LUCKY_LADY_ALLOW_REMOTE=false
CORS_ORIGINS=http://localhost:3000
# Number of proxy hops to trust, or false when the app is exposed directly.
# Getting this wrong either rate-limits every user as one, or lets a client
# forge its own IP and escape the limit.
TRUST_PROXY=false
COOKIE_SECURE=false
BODY_LIMIT=1mb
DOMAIN=localhost
ADMIN_EMAIL=operator@example.com
LOG_LEVEL=info

# --- Sports provider --------------------------------------------------------
# Optional: an unset or failing provider degrades the sportsbook only and does
# not make the application unready.
THE_ODDS_API_KEY=
THE_ODDS_API_BASE_URL=https://api.the-odds-api.com/v4
SPORTS_PROVIDER=the-odds-api
SPORTS_CACHE_TTL_SECONDS=3600
EVENTS_CACHE_TTL_SECONDS=120
ODDS_CACHE_TTL_SECONDS=20
SPORTS_PROVIDER_TIMEOUT_MS=5000
PRIMARY_BOOKMAKER_KEYS=
MAX_VIRTUAL_BET_STAKE=1000000
MAX_ACCUMULATOR_LEGS=10
MAX_ODDS_STALENESS_SECONDS=30
SPORTS_SETTLEMENT_ENABLED=false
SPORTS_SETTLEMENT_POLL_SECONDS=300
SPORTS_STALE_BET_AFTER_MINUTES=180
SPORTS_WORKER_LOCK_TTL_SECONDS=60
SPORTS_LOW_QUOTA_THRESHOLD=100

# --- Casino -----------------------------------------------------------------
CASINO_MIN_STAKE=1
CASINO_MAX_STAKE=1000000
CASINO_DICE_RTP_BPS=9700
CASINO_MINES_RTP_BPS=9700
CASINO_CRASH_RTP_BPS=9700
CASINO_CRASH_WORKER_ENABLED=true
CASINO_CRASH_SWEEP_MS=2000
CASINO_CRASH_LOCK_TTL_MS=10000

# --- Operations -------------------------------------------------------------
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
# Used only by scripts/bootstrap-admin.js, never by the running server.
BOOTSTRAP_ADMIN_EMAIL=
CONFIRM_ADMIN_BOOTSTRAP=
