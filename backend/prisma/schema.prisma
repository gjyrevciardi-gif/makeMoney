generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  MANAGER
  ADMIN
  SUPER_ADMIN
}

enum LedgerType {
  ADMIN_GRANT
  SPORTS_WIN
  CASINO_WIN
  BET_VOID_REFUND
  CASINO_ROLLBACK_REFUND
  SPORTS_BET
  CASINO_BET
  ADMIN_REMOVE
  TRANSFER_OUT
  TRANSFER_IN
}

enum BetStatus {
  OPEN
  WON
  LOST
  VOID
  CANCELLED
}

enum BetType {
  SINGLE
  ACCUMULATOR
}

enum BetLegStatus {
  OPEN
  WON
  LOST
  VOID
}

enum CasinoGameType {
  DICE
  MINES
  ROULETTE
  BLACKJACK
  CRASH
  PLINKO
  SLOTS
}

enum CasinoRoundStatus {
  OPEN
  WON
  LOST
  CASHED_OUT
  CANCELLED
}

enum CasinoTransactionType {
  BET
  WIN
  REFUND
}

enum AuditAction {
  REGISTER
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  REFRESH_SUCCESS
  REFRESH_REUSE_DETECTED
  PERMISSION_DENIED
  ADMIN_ROLE_GRANTED
  ADMIN_ROLE_REVOKED
  ADMIN_COIN_GRANT
  ADMIN_COIN_REMOVE
  ADMIN_COIN_ADJUSTMENT
  BET_PLACED
  BET_SETTLED
  BET_VOIDED
  SPORTS_RESULT_RECEIVED
  BET_LEG_SETTLED
  SPORTS_RESULT_CONFLICT
  SPORTS_SETTLEMENT_FAILED
  ADMIN_EVENT_RECONCILIATION_REQUESTED
  ADMIN_EVENT_RECONCILIATION_COMPLETED
  ADMIN_CONFLICT_ACKNOWLEDGED
  CASINO_ROUND_STARTED
  CASINO_ROUND_WON
  CASINO_ROUND_LOST
  CASINO_CASHOUT
  CASINO_ROUND_SETTLED
  CASINO_ROUND_FAILED
  CASINO_CONFIG_CREATED
  CASINO_CONFIG_ACTIVATED
  CASINO_GAME_ENABLED
  CASINO_GAME_DISABLED
  CASINO_MAINTENANCE_CHANGED
  PLATFORM_MAINTENANCE_CHANGED
  CASINO_MATH_PROFILE_GENERATED
  CASINO_MATH_PROFILE_VALIDATED
  CASINO_MATH_PROFILE_ACTIVATED
  CASINO_MATH_PAYOUT_LIFECYCLE
  ADMIN_USER_STATUS_CHANGED
  USER_CREATED
  PASSWORD_SET_BY_ADMIN
  PASSWORD_REVEALED
  PASSWORD_CHANGED
  USER_USERNAME_CHANGED
  USER_OWNER_CHANGED
  PTS_TRANSFER
  MFA_ENABLED
  MFA_RECOVERY_USED
  MFA_LOGIN_FAILED
  MFA_RESET
  SECURITY_EVENT_ACKNOWLEDGED
}

enum CasinoConfigStatus {
  DRAFT
  ACTIVE
  SUPERSEDED
}

enum SportsResultStatus {
  FINAL
  CANCELLED
  POSTPONED
  UNKNOWN
}

enum SettlementAttemptType {
  RESULT_FETCH
  SETTLEMENT
  ADMIN_RECONCILIATION
}

enum SettlementAttemptStatus {
  SUCCESS
  FAILED
  NO_RESULT
  UNSUPPORTED
  CONFLICT
  RATE_LIMITED
}

model User {
  id                    String                    @id @default(uuid()) @db.Uuid
  /// Optional: accounts are identified by `username`; email remains for accounts
  /// created before usernames existed and for operators who want one on file.
  email                 String?                   @unique
  /// Lowercase login name (3-32 of a-z 0-9 . _ -), enforced by a CHECK constraint.
  username              String?                   @unique
  /// The administrator who created this account (null for self-registered or system accounts).
  createdById           String?                   @db.Uuid
  createdBy             User?                     @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers          User[]                    @relation("UserCreatedBy")
  securityEventsAbout   SecurityEvent[]           @relation("SecurityEventSubject")
  securityEventsActed   SecurityEvent[]           @relation("SecurityEventActor")
  securityEventsOwned   SecurityEvent[]           @relation("SecurityEventOwner")
  securityEventsTop     SecurityEvent[]           @relation("SecurityEventTop")
  passwordVault         UserPasswordVault?
  totp                  UserTotp?
  recoveryCodes         UserRecoveryCode[]
  passwordHash          String
  role                  Role                      @default(USER)
  /// Account status. A disabled account's live tokens stop being accepted and
  /// privileged operations refuse it. Existing rows default to enabled.
  disabled              Boolean                   @default(false)
  createdAt             DateTime                  @default(now())
  wallet                Wallet?
  refreshTokens         RefreshToken[]
  actedEntries          LedgerEntry[]             @relation("LedgerActor")
  auditEvents           AuditLog[]                @relation("AuditActor")
  bets                  Bet[]
  casinoRounds          CasinoRound[]             @relation("CasinoPlayer")
  casinoGameFavorites   CasinoGameFavorite[]
  authoredCasinoConfigs CasinoGameConfigVersion[] @relation("CasinoConfigAuthor")
  acknowledgedConflicts SportsResultConflict[]
  gameLaunches          GameLaunchCapability[]     @relation("GameLaunchCapabilityOwner")
  gameSessions          GameSession[]              @relation("GameSessionOwner")
  gamePreparedOutcomes  GamePreparedOutcome[]      @relation("GamePreparedOutcomeOwner")
}

/// Encrypted, revealable copy of a user's password, kept ONLY so an ADMIN or
/// SUPER_ADMIN can read it back. Login never uses it (login verifies the argon2
/// hash). AES-256-GCM, bound to the owning user id, with the key held outside the
/// database. Kept in its own table so ordinary user queries never touch it.
model UserPasswordVault {
  userId      String   @id @db.Uuid
  ciphertext  String
  iv          String
  authTag     String
  keyId       String
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Google Authenticator secret, encrypted with the vault key. `enabledAt` null means enrolment was started
/// but not confirmed. `lastStep` is the last accepted 30-second step, so a code cannot be replayed.
model UserTotp {
  userId     String    @id @db.Uuid
  ciphertext String
  iv         String
  authTag    String
  keyId      String
  enabledAt  DateTime?
  lastStep   Int?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserRecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
}

model Wallet {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @unique @db.Uuid
  balance   BigInt        @default(0)
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries   LedgerEntry[]
}

model LedgerEntry {
  id                   String       @id @default(uuid()) @db.Uuid
  walletId             String       @db.Uuid
  type                 LedgerType
  amount               BigInt
  reason               String
  actorId              String?      @db.Uuid
  relatedBetId         String?      @db.Uuid
  relatedCasinoRoundId String?      @db.Uuid
  idempotencyKey       String       @unique
  /// Additive provenance for imported-game money movements. Null for the
  /// first-party games, which keep their existing conventions.
  gameSessionId        String?      @db.Uuid
  actionId             String?
  balanceBefore        BigInt?
  balanceAfter         BigInt?
  createdAt            DateTime     @default(now())
  wallet               Wallet       @relation(fields: [walletId], references: [id])
  actor                User?        @relation("LedgerActor", fields: [actorId], references: [id])
  relatedBet           Bet?         @relation(fields: [relatedBetId], references: [id])
  relatedCasinoRound   CasinoRound? @relation(fields: [relatedCasinoRoundId], references: [id])

  @@index([walletId, createdAt])
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  familyId  String    @db.Uuid
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([familyId])
}

model Bet {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String        @db.Uuid
  stake           BigInt
  type            BetType       @default(SINGLE)
  totalOdds       Decimal       @default(1) @db.Decimal(24, 8)
  finalOdds       Decimal?      @db.Decimal(24, 8)
  actualPayout    BigInt?
  potentialPayout BigInt
  status          BetStatus     @default(OPEN)
  idempotencyKey  String        @unique
  createdAt       DateTime      @default(now())
  settledAt       DateTime?
  user            User          @relation(fields: [userId], references: [id])
  legs            BetLeg[]
  ledgerEntries   LedgerEntry[]

  @@index([userId, status, createdAt])
  @@index([status, createdAt])
  @@index([status, settledAt])
}

model BetLeg {
  id              String       @id @default(uuid()) @db.Uuid
  betId           String       @db.Uuid
  provider        String
  providerEventId String
  sportKey        String       @default("unknown")
  homeTeam        String       @default("unknown")
  awayTeam        String       @default("unknown")
  marketKey       String
  marketName      String       @default("unknown")
  selectionKey    String
  selectionName   String       @default("unknown")
  acceptedOdds    Decimal      @db.Decimal(12, 4)
  marketPoint     Decimal?     @db.Decimal(12, 4)
  status          BetLegStatus @default(OPEN)
  resultMetadata  Json?
  finalHomeScore  Int?
  finalAwayScore  Int?
  createdAt       DateTime     @default(now())
  eventStartTime  DateTime
  bet             Bet          @relation(fields: [betId], references: [id], onDelete: Cascade)

  @@index([providerEventId])
  @@index([status, provider, providerEventId])
  @@index([status, eventStartTime])
}

model SportsEventResult {
  id              String             @id @default(uuid()) @db.Uuid
  provider        String
  providerEventId String
  status          SportsResultStatus
  homeScore       Int?
  awayScore       Int?
  completedAt     DateTime?
  rawResultHash   String?
  metadata        Json?
  receivedAt      DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([provider, providerEventId])
  @@index([status, updatedAt])
}

model SportsSettlementAttempt {
  id               String                  @id @default(uuid()) @db.Uuid
  provider         String
  providerEventId  String
  betId            String?                 @db.Uuid
  betLegId         String?                 @db.Uuid
  attemptType      SettlementAttemptType
  status           SettlementAttemptStatus
  errorCode        String?
  errorMessageSafe String?
  startedAt        DateTime
  finishedAt       DateTime?
  retryCount       Int                     @default(0)
  resolvedAt       DateTime?
  metadata         Json?
  createdAt        DateTime                @default(now())

  @@index([status, createdAt])
  @@index([provider, providerEventId, createdAt])
  @@index([betId])
  @@index([errorCode, resolvedAt, createdAt])
}

model SportsResultConflict {
  id                  String    @id @default(uuid()) @db.Uuid
  provider            String
  providerEventId     String
  storedResult        Json
  conflictingResult   Json
  detectedAt          DateTime  @default(now())
  acknowledgedBy      String?   @db.Uuid
  acknowledgedAt      DateTime?
  acknowledgementNote String?
  acknowledger        User?     @relation(fields: [acknowledgedBy], references: [id], onDelete: SetNull)

  @@index([provider, providerEventId, detectedAt])
  @@index([acknowledgedAt, detectedAt])
}

/// One authoritative casino round. `privateState` holds hidden game state
/// (mine positions, undrawn cards, crash point) and is never projected to a
/// client while the round is OPEN. `serverSeed` is written at creation but
/// only revealed once the round reaches a terminal status.
model CasinoRound {
  id             String              @id @default(uuid()) @db.Uuid
  userId         String              @db.Uuid
  gameType       CasinoGameType
  gameVersion    String
  status         CasinoRoundStatus   @default(OPEN)
  stake          BigInt
  multiplier     Decimal?            @db.Decimal(28, 8)
  payout         BigInt              @default(0)
  serverSeed     String
  serverSeedHash String
  clientSeed     String
  nonce          Int                 @default(0)
  publicState    Json
  privateState   Json
  idempotencyKey String              @unique
  createdAt      DateTime            @default(now())
  settledAt      DateTime?
  user           User                @relation("CasinoPlayer", fields: [userId], references: [id], onDelete: Cascade)
  actions        CasinoRoundAction[]
  transactions   CasinoTransaction[]
  ledgerEntries  LedgerEntry[]

  @@index([userId, createdAt])
  @@index([userId, gameType, status, createdAt])
  @@index([gameType, gameVersion, status])
  @@index([status, createdAt])
}

/// Append-only record of every player action applied to a round. The unique
/// idempotency key makes a retried reveal/cashout a replay rather than a
/// second mutation.
///
/// For imported third-party games this row is also the durable response cache
/// and presentation-receipt journal: `canonical` holds the validated request
/// semantics, `payload` the stored response, and `deliveredAt`/`ackedAt` the
/// transmission attempt and the client's confirmed receipt. Those columns stay
/// null for the first-party originals, which keep their own replay semantics.
model CasinoRoundAction {
  id             String      @id @default(uuid()) @db.Uuid
  /// Database-generated monotonic order: the "latest authoritative action"
  /// must never be decided by a random UUID tie-break.
  seq            Int         @default(autoincrement())
  roundId        String      @db.Uuid
  userId         String      @db.Uuid
  action         String
  payload        Json
  idempotencyKey String      @unique
  gameId         String?
  canonical      String?
  deliveredAt    DateTime?
  ackedAt        DateTime?
  createdAt      DateTime    @default(now())
  round          CasinoRound @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@index([roundId, createdAt])
  @@index([userId, gameId, createdAt])
  @@index([userId, gameId, seq])
}

/// One-time game launch capability, shared by every integrated game.
///
/// The raw opaque secret is returned to the authenticated launcher exactly once
/// and only its hash is stored, so a database read can never replay a launch.
/// Scope, actor and expiry are pinned at issue time and consumption is a single
/// conditional update.
model GameLaunchCapability {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  scope      String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  sessionId  String?   @db.Uuid
  createdAt  DateTime  @default(now())
  user       User      @relation("GameLaunchCapabilityOwner", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

/// Reconnectable gameplay capability bound to one user and one game.
///
/// The browser never learns the plaintext of another session; the stored hash is
/// the only lookup key, and gameplay re-checks the database role on every call.
/// Game-specific state never lives here: it belongs to the game's own round.
model GameSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  gameId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  lastSeenAt DateTime  @default(now())
  createdAt  DateTime  @default(now())
  user       User      @relation("GameSessionOwner", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, gameId, createdAt])
  @@index([expiresAt])
}

/// Durable prepared-outcome journal for an integrated game.
///
/// The authoritative outcome (paid board plus the whole future feature
/// sequence, or one gamble draw) is committed here before any wallet movement.
/// Settlement then consumes this stored row, so a crash or a serialization
/// failure can never cause a reroll, a second wager debit, or a lost round.
///
/// The payload is opaque to the platform: the owning adapter serializes and
/// reads back its own game-specific result and feature state.
model GamePreparedOutcome {
  id         String   @id @default(uuid()) @db.Uuid
  gameId     String
  userId     String   @db.Uuid
  requestKey String   @unique
  kind       String
  canonical  String
  body       Json
  payload    Json
  roundId    String?  @db.Uuid
  /// The session and action that produced the outcome, so a settlement
  /// reconciled after a reconnect still records its true origin.
  sessionId  String?  @db.Uuid
  actionId   String
  /// The exact round state this outcome was drawn against.
  originRoundId String?
  originVersion Int?
  originPhase   String?
  createdAt  DateTime @default(now())
  user       User     @relation("GamePreparedOutcomeOwner", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([gameId, createdAt])
}

/// Immutable, game-specific mathematics profile produced by Game Math Control.
///
/// The row is the *canonical math artifact*: `payload` is the exact evaluation
/// input the game's own engine consumes (for Lucky Lady: pre-draw stop
/// weights), and `canonicalHash` is the SHA-256 of that artifact alone. Status,
/// validation evidence and the active pointer live outside the hash, so
/// activating or re-validating a profile can never change its identity.
model GameMathProfile {
  id                String  @id @default(uuid()) @db.Uuid
  /// Registry id of the game this mathematics belongs to.
  gameId            String
  /// Operator-facing immutable identity, e.g. `lucky-lady.rtp95.v2`.
  profileId         String
  /// SHA-256 over the canonical artifact (policy + payload + engine identity).
  canonicalHash     String
  engineSha256      String
  rulesSha256       String
  targetRtpPercent  Decimal @db.Decimal(9, 4)
  measuredRtpPercent Decimal? @db.Decimal(9, 4)
  maxWinMultiplier  Decimal @db.Decimal(20, 4)
  /// The validated policy that produced this profile (bounded, whitelisted).
  policy            Json
  /// Analytical results computed at generation time (exact EV, support proof).
  analytic          Json
  /// Opaque engine-native profile body. Never interpreted by the platform.
  payload           Json
  status            String  @default("DRAFT")
  generatedBy       String  @db.Uuid
  createdAt         DateTime @default(now())
  validations       GameMathProfileValidation[]
  actives           GameActiveMathProfile[]

  @@unique([gameId, profileId])
  @@unique([gameId, canonicalHash])
  @@index([gameId, createdAt])
}

/// Append-only validation evidence for an immutable math profile.
///
/// Validation is always server-produced: it replays the frozen profile through
/// the game's own engine with seeds independent from calibration, and records
/// the analytical bounds, the Monte Carlo run and the complete-session bankroll
/// simulation that justify the pass/fail decision.
model GameMathProfileValidation {
  id            String   @id @default(uuid()) @db.Uuid
  profileRowId  String   @db.Uuid
  gameId        String
  profileId     String
  profileHash   String
  result        String
  metrics       Json
  bankroll      Json
  checks        Json
  runs          Json
  artifactPath  String
  validatedBy   String   @db.Uuid
  createdAt     DateTime @default(now())
  profile       GameMathProfile @relation(fields: [profileRowId], references: [id], onDelete: Cascade)

  @@index([profileRowId, createdAt])
  @@index([gameId, profileId, createdAt])
}

/// Durable per-game active mathematics pointer.
///
/// One row per game, and only one: a new paid round pins the identity it read,
/// so a later activation can never retroactively change a round already in
/// flight. `version` is the optimistic-concurrency token the API echoes.
///
/// `kind` is additive for the payout-policy lifecycle. `GENERATED` is the
/// classic behaviour (a specific row is active). `DEFAULT` is an explicit
/// operator restore-to-default: the pointer row and its monotonic revision are
/// retained as a tombstone so a delete/recreate can never reset the version to
/// 1, but the runtime reads no profile and the accepted immutable golden
/// mathematics stays live. `profileRowId` is nullable so a `DEFAULT` tombstone
/// holds no profile; both are null for rows written before this column existed.
model GameActiveMathProfile {
  gameId        String   @id
  profileRowId  String?  @db.Uuid
  profileId     String
  profileHash   String
  validationId  String?  @db.Uuid
  kind          String   @default("GENERATED")
  /// Exact active payout candidate id for a panel-managed transition. Null for
  /// DEFAULT and for a legacy activation that used the shared math lifecycle, so
  /// the panel never has to guess which candidate is active from the model hash.
  payoutCandidateId String?
  version       Int      @default(1)
  activatedBy   String   @db.Uuid
  activatedAt   DateTime @default(now())
  updatedAt     DateTime @updatedAt
  profile       GameMathProfile? @relation(fields: [profileRowId], references: [id], onDelete: SetNull)

  @@index([profileId])
}

/// Immutable generated payout-policy candidate.
///
/// One row binds the declared bounded generator model (the raw weighting the
/// runtime executes) to the frozen class-distribution policy the generator
/// solved for it. Both hashes and the request hash are stored verbatim; the
/// row is never edited, so a later candidate can never mutate this identity.
/// The distribution is what the runtime selects over; the model weighting is
/// what actually plays the board. Activation always binds both together.
model LuckyLadyPayoutCandidate {
  id                   String   @id @default(uuid()) @db.Uuid
  gameId               String
  candidateId          String
  /// SHA-256 over the canonical request + solver + bound model identity.
  requestHash          String?
  /// SHA-256 over the solved class-distribution policy.
  policyHash           String
  /// SHA-256 over the immutable bounded generator model artifact.
  modelHash            String
  /// Registry id of the bounded generator model this policy selects over.
  modelProfileId       String
  /// The generator model's own complete-round return under its own weights.
  declaredReturnPercent Decimal @db.Decimal(9, 4)
  /// The operator-requested target the solver was asked for.
  targetRtpPercent     Decimal  @db.Decimal(9, 4)
  maxWinMultiplier     Int
  style                String
  /// Normalized request the solver accepted (with applied floors).
  request              Json
  /// The solved class-distribution policy, frozen with the candidate.
  distributionPolicy   Json
  /// The immutable model artifact (MathProfileArtifact) the runtime pins.
  modelArtifact        Json
  createdBy            String   @db.Uuid
  createdAt            DateTime @default(now())
  validations          LuckyLadyPayoutValidation[]
  activations          LuckyLadyPayoutActivation[]

  @@unique([gameId, candidateId])
  @@unique([gameId, policyHash])
  @@index([gameId, createdAt])
  @@index([modelHash])
}

/// Append-only server evidence for one payout candidate.
///
/// The report is produced entirely by the accepted generator + bankroll
/// simulator from the frozen candidate; it is never accepted from a client.
/// `status` is the honest lifecycle verdict (VALIDATED / GENERATED /
/// INFEASIBLE / SEARCH_EXHAUSTED / REJECTED) - activation reads the row, not
/// the HTTP response.
model LuckyLadyPayoutValidation {
  id             String   @id @default(uuid()) @db.Uuid
  candidateRowId String   @db.Uuid
  gameId         String
  candidateId    String
  policyHash     String
  modelHash      String
  status         String
  verdict        String
  report         Json
  metrics        Json
  artifactPath   String
  validatedBy    String   @db.Uuid
  createdAt      DateTime @default(now())
  candidate      LuckyLadyPayoutCandidate @relation(fields: [candidateRowId], references: [id], onDelete: Cascade)

  @@index([candidateRowId, createdAt])
  @@index([gameId, candidateId, createdAt])
}

/// Append-only payout activation history.
///
/// Every ACTIVE / ROLLBACK / DEFAULT transition appends exactly one row in the
/// same transaction as the pointer move and the audit entry. `actionId` is the
/// caller's idempotency key: an exact replay returns this recorded transition,
/// while the same key with different semantics is a conflict. `previous`
/// records the pre-transition snapshot so a later rollback is a NEW event over
/// a trusted server value, never a client-chosen previous policy.
model LuckyLadyPayoutActivation {
  id             String   @id @default(uuid()) @db.Uuid
  gameId         String
  actionId       String
  action         String
  candidateRowId String?  @db.Uuid
  /// Operator-facing candidate id recorded on the transition.
  candidateId    String?
  modelProfileId String?
  policyHash     String?
  modelHash      String?
  targetRtpPercent Decimal? @db.Decimal(9, 4)
  maxWinMultiplier Int?
  style          String?
  version        Int
  previous       Json
  actorId        String   @db.Uuid
  createdAt      DateTime @default(now())
  candidate      LuckyLadyPayoutCandidate? @relation(fields: [candidateRowId], references: [id], onDelete: SetNull)

  @@unique([gameId, actionId])
  @@index([gameId, createdAt])
}

/// Game-domain view of casino value movement. The immutable LedgerEntry table
/// remains the single authoritative source of wallet balance; this table never
/// competes with it.
model CasinoTransaction {
  id             String                @id @default(uuid()) @db.Uuid
  roundId        String                @db.Uuid
  userId         String                @db.Uuid
  type           CasinoTransactionType
  amount         BigInt
  idempotencyKey String                @unique
  createdAt      DateTime              @default(now())
  round          CasinoRound           @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@index([roundId])
  @@index([userId, createdAt])
}

/// Per-user casino discovery preference. `gameId` references the static,
/// validated CasinoGameRegistry at the service boundary rather than a second
/// database-owned game catalogue.
model CasinoGameFavorite {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  gameId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
  @@index([userId, createdAt])
}

/// Administrator-controlled operational state for one registry game.
///
/// The registry still owns the immutable catalogue (identity, route, category);
/// this row owns only what an operator may legitimately change at runtime.
model CasinoGameConfig {
  id              String                    @id @default(uuid()) @db.Uuid
  gameId          String                    @unique
  enabled         Boolean                   @default(true)
  maintenance     Boolean                   @default(false)
  activeVersionId String?                   @unique @db.Uuid
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  activeVersion   CasinoGameConfigVersion?  @relation("CasinoActiveVersion", fields: [activeVersionId], references: [id])
  versions        CasinoGameConfigVersion[] @relation("CasinoConfigVersions")
}

/// One immutable mathematical configuration for a game.
///
/// A version's numbers never change after it is written. Activating different
/// mathematics means creating a new version and superseding the old one, so a
/// round settled under an earlier version stays reproducible forever.
model CasinoGameConfigVersion {
  id                 String             @id @default(uuid()) @db.Uuid
  gameConfigId       String             @db.Uuid
  version            Int
  /// Deterministic label recorded on every round, e.g. `dice.v2.rtp9500`.
  label              String
  status             CasinoConfigStatus @default(DRAFT)
  minStake           BigInt
  maxStake           BigInt
  /// Null for games whose return is fixed by canonical rules rather than a dial.
  rtpBps             Int?
  gameSpecificConfig Json
  createdByAdminId   String?            @db.Uuid
  reason             String?
  createdAt          DateTime           @default(now())
  activatedAt        DateTime?
  supersededAt       DateTime?
  config             CasinoGameConfig   @relation("CasinoConfigVersions", fields: [gameConfigId], references: [id], onDelete: Cascade)
  activeFor          CasinoGameConfig?  @relation("CasinoActiveVersion")
  createdBy          User?              @relation("CasinoConfigAuthor", fields: [createdByAdminId], references: [id], onDelete: SetNull)

  @@unique([gameConfigId, version])
  @@unique([gameConfigId, label])
  @@index([gameConfigId, status])
}

/// Single-row platform switchboard for global maintenance states.
model PlatformSettings {
  id                    String   @id @default("singleton")
  casinoMaintenance     Boolean  @default(false)
  sportsbookMaintenance Boolean  @default(false)
  updatedByAdminId      String?  @db.Uuid
  updatedAt             DateTime @updatedAt
  createdAt             DateTime @default(now())
}

model AuditLog {
  id         String      @id @default(uuid()) @db.Uuid
  actorId    String?     @db.Uuid
  targetType String?
  targetId   String?
  action     AuditAction
  result     String
  ip         String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime    @default(now())
  actor      User?       @relation("AuditActor", fields: [actorId], references: [id])

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([targetId, createdAt])
}

enum SecurityEventType {
  PTS_GRANTED
  PTS_REMOVED
  BIG_WIN
  HUGE_WIN
  PASSWORD_CHANGED
  PTS_TRANSFERRED
  PTS_RECLAIMED
}

enum SecuritySeverity {
  INFO
  WARNING
  ALERT
}

/// A notification for the security page. Written in the same transaction as the money movement it
/// describes, so it cannot be skipped. `ownerAdminId` is the subject's owner at that moment: an ADMIN
/// sees only events about their own users, a SUPER_ADMIN sees all.
model SecurityEvent {
  id               String            @id @default(uuid()) @db.Uuid
  type             SecurityEventType
  severity         SecuritySeverity
  subjectUserId    String            @db.Uuid
  actorId          String?           @db.Uuid
  ownerAdminId     String?           @db.Uuid
  topOwnerId       String?           @db.Uuid
  amount           BigInt
  balanceAfter     BigInt?
  reason           String?
  refType          String?
  refId            String?
  createdAt        DateTime          @default(now())
  acknowledgedAt   DateTime?
  acknowledgedById String?           @db.Uuid
  subject          User              @relation("SecurityEventSubject", fields: [subjectUserId], references: [id], onDelete: Restrict)
  actor            User?             @relation("SecurityEventActor", fields: [actorId], references: [id], onDelete: SetNull)
  owner            User?             @relation("SecurityEventOwner", fields: [ownerAdminId], references: [id], onDelete: SetNull)
  top              User?             @relation("SecurityEventTop", fields: [topOwnerId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([ownerAdminId, createdAt])
  @@index([topOwnerId, createdAt])
  @@index([subjectUserId, createdAt])
  @@index([acknowledgedAt])
}
